# SXSVN AI news-intelligence module.
# Copy to .env and fill in real values. Never commit the real .env.
# All variables are optional unless marked REQUIRED.

# --- LLM (OpenAI-compatible provider) ---------------------------------
# REQUIRED for fact extraction / LLM classification / LLM synthesis.
LLM_API_KEY=
LLM_BASE_URL=https://changellenge.up.railway.app/v1
# Preliminary default: no comparative benchmark was run for this module.
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_TIMEOUT=45
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=3000
LLM_MAX_INPUT_CHARS=24000
# json_object | json_schema | none
LLM_RESPONSE_FORMAT=json_object
LLM_BACKOFF_BASE=0.5
LLM_BACKOFF_MAX=8.0
# Set to 1 only for a local/mock provider outside the approved model list.
LLM_ALLOW_ANY_MODEL=0

# llm | rules | auto
# auto = LLM when LLM_API_KEY is set, otherwise the deterministic rule fallback.
CLASSIFIER_MODE=auto

# --- Existing Redis queue (do not create a second queue) --------------
REDIS_URL=redis://localhost:6379/0
NEWS_QUEUE_KEY=sxsvn:news:queue
NEWS_PROCESSING_KEY=sxsvn:news:processing
NEWS_DEAD_LETTER_KEY=sxsvn:news:dead_letter
NEWS_JOB_META_KEY=sxsvn:news:job_meta
NEWS_RETRY_DELAY_KEY=sxsvn:news:delayed
WORKER_VISIBILITY_TIMEOUT=900
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_DELAY=5
WORKER_BLOCK_TIMEOUT=5

# --- Processing -------------------------------------------------------
PROCESSING_VERSION=v1
# Product limit: at most 2 additional searches per company analysis.
INSIGHT_MAX_ADDITIONAL_SEARCHES=2
INSIGHT_MAX_RELATIONSHIPS=50
INSIGHT_MAX_FACTS=40

# --- Storage ----------------------------------------------------------
# SQLite is for local runs/tests. Production should pass explicit
# PostgreSQL adapters (see docs/INTEGRATION.md).
INTEL_SQLITE_PATH=./intel.db
# Read-only adapters for tables owned by other teams.
INTEL_NEWS_TABLE=news
INTEL_COMPANY_TABLE=companies

# --- CLI logging ------------------------------------------------------
LOG_LEVEL=INFO
