# Copy to .env locally and fill in the key supplied to your team.
SXSVN_LLM_API_KEY=sk-your-team-key
SXSVN_LLM_BASE_URL=https://changellenge.up.railway.app/v1
SXSVN_LLM_MODEL=deepseek/deepseek-v4.1-flash
SXSVN_LLM_TIMEOUT=30
SXSVN_LLM_MAX_RETRIES=2
SXSVN_LLM_MAX_INPUT_CHARS=40000
SXSVN_LLM_MAX_OUTPUT_TOKENS=2000
SXSVN_CACHE_TTL_SECONDS=900
SXSVN_CACHE_MAX_SIZE=1024
SXSVN_MAX_SEARCH_STEPS=2
SXSVN_LLM_RETRIES=2
# Manual integration test only; never enable in CI.
SXSVN_RUN_INTEGRATION=0
